{
  "name": "rider-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:env": "node scripts/check-public-env.mjs",
    "check": "pnpm check:env && pnpm check:i18n && pnpm lint && pnpm typecheck && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --local --schema public,api,private,audit --level warning --fail-on warning",
    "db:types": "supabase gen types typescript --local --schema public --schema api > src/types/database.gen.ts && oxfmt src/types/database.gen.ts",
    "dev:bootstrap-admin": "node scripts/dev-bootstrap-admin.mjs",
    "seed:hosted-users": "node scripts/seed-hosted-users.mjs",
    "test:e2e": "playwright test",
    "with-local": "node scripts/with-local-supabase.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "postinstall": "node scripts/copy-vendor.mjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hookform/resolvers": "7.0.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.5.1",
    "date-fns": "4.4.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.66.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "oxfmt": "^0.75.0",
    "pino-pretty": "13.2.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
