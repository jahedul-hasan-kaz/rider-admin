# Copy to .env.local and fill in. Never commit real values.
# docs/spec/01-architecture.md §6

# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://nhjwfxbmuplfodmrxjag.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_APP_ENV=local

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
APP_BASE_URL=http://localhost:3000
ROUTING_PROVIDER=haversine
ROUTING_API_KEY=
SENTRY_DSN=
INTERNAL_JOBS_SECRET=
LOG_LEVEL=info

# Notifications (default "log" sends nothing). Run POST /api/internal/jobs/notify with the bearer secret on a schedule.
INTERNAL_JOBS_ALLOWED_IPS=
NOTIFY_EMAIL_PROVIDER=log
NOTIFY_FROM=
RESEND_API_KEY=
MAILPIT_URL=
NOTIFY_SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_PUSH_PROVIDER=log
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=

# Demo accounts (admin@yopmail.com, rider@yopmail.com, customer@yopmail.com) are created at app start for staging.
# Default: on everywhere except NEXT_PUBLIC_APP_ENV=production. Set SEED_DEMO_USERS=false to turn off, =true to force on.
SEED_DEMO_USERS=
DEMO_PASSWORD=
# true: once, at app start, fill every feature with sample data (staff with different permissions, passengers,
# drivers, ~90 rides, money, support, safety). Staging only; ignored when NEXT_PUBLIC_APP_ENV=production.
SEED_DEMO_DATA=
